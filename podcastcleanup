def get_audio_fingerprint(the_file):
    try:
        raw = subprocess.check_output(
            ["ffmpeg", "-hide_banner", "-loglevel", "error", "-i", the_file, "-vn",
             "-f", "chromaprint", "-fp_format", "raw", "-"],
            stderr=FNULL)
    except subprocess.CalledProcessError:
        return None
    fp = np.frombuffer(raw, dtype="<u4")
    if len(fp) < FP_WINDOW_FRAMES:
        return None
    return fp

def candidate_offsets(short, long):
    # Offsets (position in long - position in short) at which many frames share
    # the same top bits.
    long_keys = long >> FP_HASH_SHIFT
    order = np.argsort(long_keys, kind="stable")
    sorted_keys = long_keys[order]
    short_keys = short >> FP_HASH_SHIFT
    lo = np.searchsorted(sorted_keys, short_keys, side="left")
    counts = np.searchsorted(sorted_keys, short_keys, side="right") - lo
    # Very common values (silence, mostly) match everywhere, ignore them.
    idx = np.nonzero((counts > 0) & (counts <= 8))[0]
    if len(idx) == 0:
        return []
    c = counts[idx]
    within = np.arange(c.sum()) - np.repeat(np.cumsum(c) - c, c)
    long_pos = order[np.repeat(lo[idx], c) + within]
    offsets = long_pos - np.repeat(idx, c)
    histogram = np.bincount(offsets + len(short))
    result = []
    for o in np.argsort(histogram)[::-1]:
        if histogram[o] < 2 or len(result) >= FP_CANDIDATE_OFFSETS:
            break
        o = int(o) - len(short)
        if all(abs(o - r) > 2 for r in result):
            result.append(o)
    return result

def fingerprint_coverage(a, b):
    # Returns (fraction of shorter matched in longer, fraction of longer matched)
    (short, long) = (a, b) if len(a) <= len(b) else (b, a)
    offsets = candidate_offsets(short, long)
    if not offsets:
        return (0.0, 0.0)
    window = np.ones(FP_WINDOW_FRAMES) / FP_WINDOW_FRAMES
    errors = np.full((len(offsets), len(short)), 1.0)
    for (i, o) in enumerate(offsets):
        start = max(0, -o)
        end = min(len(short), len(long) - o)
        if end <= start:
            continue
        bits = np.full(len(short), 32.0)
        bits[start:end] = np.bitwise_count(short[start:end] ^ long[start + o:end + o])
        errors[i] = np.convolve(bits / 32, window, mode="same")
    best = np.argmin(errors, axis=0)
    matched = np.nonzero(errors[best, np.arange(len(short))] <= FP_MAX_BIT_ERROR)[0]
    long_positions = np.unique(matched + np.array(offsets)[best[matched]])
    return (len(matched) / len(short), len(long_positions) / len(long))

def find_duplicate_episodes(folder):
    files = sorted([
        os.path.join(folder, f) for f in os.listdir(folder)
        if not f.startswith(".") and os.path.isfile(os.path.join(folder, f))])
    if len(files) < 2:
        return []
    with multiprocessing.Pool(max(1, multiprocessing.cpu_count() // 2)) as pool:
        fingerprints = pool.map(get_audio_fingerprint, files)
    episodes = [(f, fp) for (f, fp) in zip(files, fingerprints) if fp is not None]
    # Union-find over pairs of duplicates
    parent = list(range(len(episodes)))
    def root(i):
        while parent[i] != i:
            i = parent[i]
        return i
    for i in range(len(episodes)):
        for j in range(i + 1, len(episodes)):
            (fp1, fp2) = (episodes[i][1], episodes[j][1])
            # Cheap filter: can't satisfy both coverage thresholds
            if min(len(fp1), len(fp2)) * DUPE_MIN_SHORTER_COVERAGE < \
                    max(len(fp1), len(fp2)) * DUPE_MIN_LONGER_COVERAGE:
                continue
            (shorter_cov, longer_cov) = fingerprint_coverage(fp1, fp2)
            if DEBUG and shorter_cov > 0.2:
                print("  %.2f / %.2f  %s  %s" % (
                    shorter_cov, longer_cov,
                    os.path.basename(episodes[i][0]), os.path.basename(episodes[j][0])))
            if shorter_cov >= DUPE_MIN_SHORTER_COVERAGE and longer_cov >= DUPE_MIN_LONGER_COVERAGE:
                parent[root(j)] = root(i)
    groups = {}
    for i in range(len(episodes)):
        groups.setdefault(root(i), []).append(episodes[i])
    # Longest first: that's the one we keep
    return [sorted(g, key=lambda e: -len(e[1])) for g in groups.values() if len(g) > 1]

def dedupe_episodes(folder):
    for group in find_duplicate_episodes(folder):
        print("Duplicate episodes in " + folder + ":")
        for (i, (f, fp)) in enumerate(group):
            seconds = int(len(fp) * 0.1238)  # chromaprint frame duration
            print("  %s %dm%02ds  %s" % (
                "keep  " if i == 0 else "delete", seconds // 60, seconds % 60,
                os.path.basename(f)))
            if i > 0 and ACTUALLY_DELETE_DUPES:
                os.remove(f)

def remove_empty_folders():
    for f in FOLDERS:
        if not os.path.exists(f):
            continue
        os.chdir(f)
        episodes = sorted([f for f in os.listdir() if is_audio_file(f)])
        os.chdir("..")
        if len(episodes) == 0:
            os.system("rmdir '" + f + "'")

if __name__ == "__main__":
    # Don't use getcwd(), we want to keep symlinks unresolved
    CURRENT = os.getenv("PWD")
    if CURRENT.endswith("/"):
        CURRENT = CURRENT[:-1]
    SINGLE_FOLDER = False
    # If we are in a podcast folder, only process this one
    if CURRENT in FOLDERS:
        FOLDERS = [CURRENT]
        SINGLE_FOLDER = True
        print("Single folder mode...")
    else:
        static_file_rename_and_cleanup()

    for f in FOLDERS:
        if not os.path.exists(f):
            continue
        print(f + "...")
        os.chdir(f)
        episodes = sorted([f for f in os.listdir() if is_audio_file(f)])
        n_threads = multiprocessing.cpu_count() - 1
        pool = multiprocessing.Pool(n_threads)
        results = pool.map(process_one_episode, episodes)
        pool.close()
        pool.join()
        os.chdir("..")
        dedupe_episodes(f)

    if not SINGLE_FOLDER:
        # Call 'keep_only_latest_episode_in_folder_matching_name' here if needed
        pass

    remove_empty_folders()

    print("Removing backups...")
    os.system("find -name '*.bup' -delete")
    print("All done.")
