#!/usr/bin/python3

import json
import multiprocessing
import os
import re
import subprocess
import numpy as np
import util

DEBUG = True

# When False, sets of near-identical episodes are only printed out.
ACTUALLY_DELETE_DUPES = False

HOME = os.path.expanduser("~")

PODCASTS_DIR = os.path.join("sync", "s", "podcasts")
FOLDERS_RAW = sorted([
    os.path.join(HOME, PODCASTS_DIR, d) for d in os.listdir(os.path.join(HOME, PODCASTS_DIR))])
FOLDERS = []
for f in FOLDERS_RAW:
    FOLDERS.append(f[:-1] if f.endswith("/") else f)
DATE_PATTERN = r"^\d\d\d\d\-\d\d\-\d\d"
AUDIO_EXTENSIONS = (".mp3", ".m4a")

def is_audio_file(f):
    return f.lower().endswith(AUDIO_EXTENSIONS)

TAGS_DB = {}
SEEN_DURATIONS = []
SEEN_FP = []
FNULL = open(os.devnull, "w")
OVERRIDE_DATES_CURRENTLY_IN_FILENAME = True

# Audio de-duping parameters. Fingerprints are chromaprint frames (~8 per second).
# Two episodes are duplicates when most of the shorter one is found in the longer
# one, and the longer one is not mostly made of other content (ads, silence...).
DUPE_MIN_SHORTER_COVERAGE = 0.8
DUPE_MIN_LONGER_COVERAGE = 0.5
# Frames match when fewer than this fraction of their 32 bits differ (on average
# over a sliding window). Unrelated audio sits around 0.5.
FP_MAX_BIT_ERROR = 0.25
FP_WINDOW_FRAMES = 16
# Ads inserted in the middle shift alignment, so try several offsets.
FP_CANDIDATE_OFFSETS = 10
FP_HASH_SHIFT = 12

def podcast_hash(the_file):
    return subprocess.check_output(["md5sum", the_file]).decode().split(" ")[0]

def process_id3v2_tags(fp, data):
    if fp in TAGS_DB:
        tags = TAGS_DB[fp]
    else:
        tags = {}
    for l in data.split("\n"):
        if ":" not in l:
            continue
        if " " not in l:
            continue
        tag = l.split(" ", 1)[0]
        if len(tag) != 4:
            continue
        (_, value) = l.split(":", 1)
        tags[tag] = value.strip()
    TAGS_DB[fp] = tags

def process_eyed3_tags(fp, data):
    if fp in TAGS_DB:
        tags = TAGS_DB[fp]
    else:
        tags = {}
    for l in data.split("\n"):
        if ":" not in l:
            continue
        if l.startswith("ID3"):
            continue
        # Workaround for when 'track' and 'genre' are on the same line
        if "track" in l and "genre" in l:
            l = l[:l.index("genre")]
        (tag, value) = l.split(":", 1)
        tags[tag] = value.strip()
    TAGS_DB[fp] = tags

def get_tag_from_cache(fp, tag):
    if fp in TAGS_DB:
        if tag in TAGS_DB[fp]:
            return TAGS_DB[fp][tag]
    return None

def process_ffprobe_tags(fp, e):
    # id3v2/eyeD3 don't understand m4a's atom-based metadata; ffprobe does,
    # and exposes it under generic lowercase keys (title, artist, date...)
    # which happen to line up with the eyeD3 fallback keys used elsewhere.
    if fp not in TAGS_DB:
        TAGS_DB[fp] = {}
    try:
        raw = subprocess.check_output(
            ["ffprobe", "-v", "error", "-show_entries", "format_tags",
             "-of", "json", e], stderr=FNULL).decode()
        tags = json.loads(raw).get("format", {}).get("tags", {})
    except (subprocess.CalledProcessError, json.JSONDecodeError):
        return
    for (tag, value) in tags.items():
        TAGS_DB[fp][tag.lower()] = value.strip() if isinstance(value, str) else value

def get_tag(e, tag):
    fp = podcast_hash(e)
    # Assume we've retrieved all the tags at once
    if fp in TAGS_DB:
        return get_tag_from_cache(fp, tag)
    if e.lower().endswith(".m4a"):
        process_ffprobe_tags(fp, e)
        return get_tag_from_cache(fp, tag)
    try:
	      data = subprocess.check_output(["id3v2", "-l", e]).decode().strip()
    except UnicodeDecodeError:
        print("Decoding error on " + str(e))
        return ""
    if "no id3v2 tags" not in data.lower() and data != "":
        process_id3v2_tags(fp, data)
    data = subprocess.check_output(
        ["eyeD3", "--log-level=critical", e],
        stderr=FNULL).decode().strip()
    process_eyed3_tags(fp, data)
    return get_tag_from_cache(fp, tag)

def get_episode_number(e):
    for t in ["TRCK", "track"]:
        candidate = get_tag(e, t)
        if candidate and int(candidate) > 1:
            return str(int(candidate)).zfill(4)
    return None

def get_title(e):
    for t in ["TIT2", "title"]:
        candidate = get_tag(e, t)
        if candidate:
            return candidate
    return "unknown"

def harvest_date_from_tag(t):
    if not t:
        return None
    t = t.strip()
    if "20" in t and t.count("-") == 2:
        if " " not in t and len(t) == len("YYYY-MM-DD"):
            return t
        if " " in t:
            return harvest_date_from_tag(t.split(" ")[0])
    return None

def harvest_date_from_filename(e):
    # Some feeds (e.g. Radio France m4a downloads) carry no date tag at all,
    # but embed one as DD.MM.YYYY in the original filename.
    m = re.search(r"(\d\d)\.(\d\d)\.(20\d\d)", os.path.basename(e))
    if m:
        (day, month, year) = m.groups()
        return "-".join([year, month, day])
    return None

def get_date(e):
    y = get_tag(e, "TYER")
    d = get_tag(e, "TDAT")
    d2 = get_tag(e, "TRDA")
    candidate = harvest_date_from_tag(d2)
    if candidate:
        return candidate
    candidate = harvest_date_from_tag(d)
    if candidate:
        return candidate
    if y and d and len(y) == 4 and len(d) == 4:
        m = d[2:]
        d = d[:2]
        return "-".join([y, m, d])
    for t in ["recording date", "release date", "TDAT", "date"]:
        candidate = get_tag(e, t)
        if candidate:
            candidate = candidate.strip()
            if len(candidate) == 4:
                # We just have a year
                return candidate + "-01-01"
            if re.match(DATE_PATTERN, candidate) is not None:
                # Already in YYYY-MM-DD form, e.g. ffprobe's "date" tag.
                return candidate[:10]
            dateparts = candidate.split("-")
            if len(dateparts) != 3:
                return None
            # Reverse the date format.
            date = "-".join([dateparts[2], dateparts[1], dateparts[0]])
            if re.match(DATE_PATTERN, date) is not None:
                return date
    # except UnicodeDecodeError:
        # noop = "hop"
    return harvest_date_from_filename(e)

def get_duration(e):
    # ffprobe reads both mp3 and m4a, unlike mp3info which is mp3-only.
    try:
        raw = subprocess.check_output(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "csv=p=0", e], stderr=FNULL).decode().strip()
        total_seconds = int(float(raw))
    except (subprocess.CalledProcessError, ValueError):
        print("Couldn't get duration for " + e)
        return "unknown"
    return "%02dm%02d" % (total_seconds // 60, total_seconds % 60)

def process_one_episode(e):
    if DEBUG:
        print("Processing " + e + "....")
    override_date = OVERRIDE_DATES_CURRENTLY_IN_FILENAME
    date_prefix = util.get_date_prefix()
    if override_date:
        date = get_date(e)
        if date:
            date_prefix = date
    title = get_title(e)
    duration = get_duration(e)
    episode_number = get_episode_number(e)
    title = util.sanitize_for_filename(title)
    if title.startswith("."):
        title = title[1:]
    fp = podcast_hash(e)
    if duration not in SEEN_DURATIONS:
        SEEN_DURATIONS.append(duration)
    if fp in SEEN_FP:
        cmd = "rm " + e
        os.system(cmd)
    else:
        SEEN_FP.append(fp)
    if episode_number:
        parts = [episode_number]
    else:
        parts = [date_prefix]
    parts.append(title)
    parts.append(duration)
    ext = os.path.splitext(e)[1].lower()
    final_name = "_".join(parts) + ext
    final_name = util.sanitize_for_filename(final_name)
    if e != final_name:
        cmd = "mv '" + e + "' '" + final_name + "'"
        os.system(cmd)
    return "unused_result"

def keep_only_latest_episode_in_folder_matching_name(name):
    if DEBUG:
        print("Keeping only one in '" + name + "'")
    for f in FOLDERS:
        if name.lower() in f.lower():
            os.chdir(f)
            episodes = sorted([f for f in os.listdir() if is_audio_file(f)])
            if len(episodes) > 1:
                cmd = "rm " + " ".join(["'" + e + "'" for e in episodes[:-1]])
                os.system(cmd)
            os.chdir("..")

